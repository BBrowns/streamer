{
  "version": 1,
  "visualCaseMappings": [
    {
      "patterns": [
        "^apps/mobile/app/\\(tabs\\)/index\\.tsx$",
        "^apps/mobile/components/catalog/"
      ],
      "cases": ["home-desktop", "home-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/\\(tabs\\)/library\\.tsx$",
        "^apps/mobile/components/library/"
      ],
      "cases": ["library-desktop", "library-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/\\(tabs\\)/settings\\.tsx$",
        "^apps/mobile/app/settings/",
        "^apps/mobile/components/settings/"
      ],
      "cases": ["settings-desktop", "settings-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/\\(tabs\\)/search\\.tsx$",
        "^apps/mobile/app/search/",
        "^apps/mobile/components/search/"
      ],
      "cases": ["search-desktop", "search-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/detail/",
        "^apps/mobile/components/detail/"
      ],
      "cases": ["detail-desktop", "detail-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/\\(tabs\\)/downloads\\.tsx$",
        "^apps/mobile/components/downloads/"
      ],
      "cases": ["downloads-desktop", "downloads-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/player\\.tsx$",
        "^apps/mobile/components/player/"
      ],
      "cases": ["player-desktop", "player-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/addons/",
        "^apps/mobile/components/addons/"
      ],
      "cases": ["addons-desktop", "addons-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/app/notifications/",
        "^apps/mobile/app/\\(tabs\\)/notifications\\.tsx$",
        "^apps/mobile/components/notifications/"
      ],
      "cases": ["notifications-desktop", "notifications-phone"]
    },
    {
      "patterns": ["^apps/mobile/app/login\\.tsx$"],
      "cases": ["login-desktop", "login-phone"]
    },
    {
      "patterns": ["^apps/mobile/app/onboarding/"],
      "cases": ["onboarding-desktop", "onboarding-phone"]
    },
    {
      "patterns": [
        "^apps/mobile/components/ui/",
        "^apps/mobile/constants/theme\\.ts$",
        "^apps/mobile/components/navigation/",
        "^apps/mobile/app/_layout\\.tsx$"
      ],
      "cases": [
        "addons-desktop",
        "addons-phone",
        "detail-desktop",
        "detail-phone",
        "downloads-desktop",
        "downloads-phone",
        "home-desktop",
        "home-phone",
        "library-desktop",
        "library-phone",
        "login-desktop",
        "login-phone",
        "notifications-desktop",
        "notifications-phone",
        "onboarding-desktop",
        "onboarding-phone",
        "player-desktop",
        "player-phone",
        "search-desktop",
        "search-phone",
        "settings-desktop",
        "settings-phone"
      ]
    }
  ],
  "rules": [
    {
      "id": "gauntlet-process",
      "visualImpact": "no",
      "patterns": [
        "^scripts/gauntlet(?:-[^/]*)?\\.mjs$",
        "^scripts/gauntlet(?:-[^/]*)?\\.test\\.mjs$",
        "^docs/gauntlet/"
      ],
      "focusedCommands": [
        "node --test scripts/gauntlet.test.mjs scripts/gauntlet-package.test.mjs",
        "npm run process:check"
      ],
      "finalCommands": []
    },
    {
      "id": "process",
      "visualImpact": "no",
      "patterns": [
        "^\\.agents/",
        "^\\.codex/",
        "^AGENTS\\.md$",
        "^config/verification-map\\.json$",
        "^scripts/(validate-process-assets|validate-skill-evals|evaluate-skill-outcomes|verify-change|runtime-preflight|qa-run|maintenance-collect|maintenance-report|dev-runtime)"
      ],
      "focusedCommands": [
        "npm run process:check",
        "npm run process:check:test",
        "npm run dev:runtime:test",
        "npm run hooks:runtime:test"
      ],
      "finalCommands": []
    },
    {
      "id": "workflow-policy",
      "visualImpact": "no",
      "patterns": [
        "^\\.github/workflows/",
        "^\\.github/required-checks\\.json$",
        "^scripts/(check-github-actions|ci-affected|ci-install|ci-needs-check|change-scope-parity)"
      ],
      "focusedCommands": [
        "npm run process:check",
        "npm run workflows:check",
        "npm run workflows:check:test",
        "node --test scripts/ci-affected.test.mjs scripts/ci-needs-check.test.mjs"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "shared-contract",
      "visualImpact": "no",
      "patterns": ["^packages/shared/"],
      "focusedCommands": [
        "npm run test --workspace=@streamer/shared",
        "npm run typecheck:all"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "golden-path-test-support",
      "visualImpact": "no",
      "patterns": ["^tests/golden-path/"],
      "focusedCommands": ["npm run test:golden-path"],
      "finalCommands": []
    },
    {
      "id": "mobile-ui",
      "visualImpact": "yes",
      "patterns": ["^apps/mobile/.*\\.(tsx|jsx|css)$"],
      "focusedCommands": [
        "npm run test --workspace=apps/mobile",
        "npm run typecheck --workspace=apps/mobile",
        "npm run test:golden-path",
        "npm run test:visual"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "mobile",
      "visualImpact": "no",
      "patterns": ["^apps/mobile/"],
      "focusedCommands": [
        "npm run test --workspace=apps/mobile",
        "npm run typecheck --workspace=apps/mobile"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "server",
      "visualImpact": "no",
      "patterns": ["^server/"],
      "focusedCommands": [
        "npm run test --workspace=server",
        "npm run typecheck --workspace=server"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "stream-server",
      "visualImpact": "no",
      "patterns": ["^packages/stream-server/"],
      "focusedCommands": [
        "npm run test --workspace=@streamer/stream-server",
        "npm run typecheck --workspace=@streamer/stream-server"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "desktop",
      "visualImpact": "unknown",
      "patterns": ["^apps/desktop/"],
      "focusedCommands": [
        "npm run test --workspace=@streamer/desktop",
        "npm run test:electron-smoke"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "release-tooling",
      "visualImpact": "no",
      "patterns": ["^scripts/(release-gate|release-sbom|rc-evidence)"],
      "focusedCommands": ["npm run release:gate"],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "dependency",
      "visualImpact": "unknown",
      "patterns": [
        "(^|/)package\\.json$",
        "^package-lock\\.json$",
        "^patches/",
        "^scripts/(security-audit|check-install-script-policy|dependency-)"
      ],
      "focusedCommands": [
        "npm run dependency:compatibility:test",
        "npm run security:install-scripts",
        "npm run security:audit"
      ],
      "finalCommands": ["npm run verify:quick"]
    },
    {
      "id": "documentation",
      "visualImpact": "no",
      "patterns": [
        "^docs/",
        "^design/",
        "^(README|ARCHITECTURE|PLAYBACK|UI|AGENT_HANDOFF|ROADMAP)\\.md$"
      ],
      "focusedCommands": ["npm run format:check"],
      "finalCommands": []
    }
  ],
  "fallback": {
    "id": "repository-code",
    "visualImpact": "unknown",
    "focusedCommands": ["npm run verify:quick"],
    "finalCommands": []
  }
}
