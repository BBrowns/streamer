{
  "name": "mobile",
  "main": "index.js",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "npm run test:e2e:ios",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "node ../../scripts/android-detox.cjs test --configuration android.emu.debug",
    "build:e2e": "npm run build:e2e:ios",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "build:e2e:android": "node ../../scripts/android-detox.cjs build --configuration android.emu.debug",
    "eas-build-pre-install": "node scripts/eas-build-pre-install.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@sentry/react-native": "~8.31.0",
    "@shopify/flash-list": "2.3.3",
    "@streamer/shared": "*",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "expo": "~58.0.14",
    "expo-blur": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.17",
    "expo-video": "~58.0.11",
    "expo-web-browser": "~58.0.6",
    "hls.js": "^1.7.3",
    "hono": "~4.13.2",
    "i18next": "^26.5.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.18",
    "react-native": "0.88.0",
    "react-native-airplay-btn": "^1.1.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-image-colors": "2.6.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "semver": "^7.8.5",
    "tailwindcss": "3.4.19",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "detox": "^20.31.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@sentry/react-native",
        "@shopify/flash-list",
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
