{
  "name": "mobile",
  "main": "index.js",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "npm run test:e2e:ios",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "build:e2e": "npm run build:e2e:ios",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "build:e2e:android": "detox build --configuration android.emu.debug",
    "eas-build-pre-install": "node scripts/eas-build-pre-install.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@sentry/react-native": "~8.24.0",
    "@shopify/flash-list": "2.3.2",
    "@streamer/shared": "*",
    "@tanstack/react-query": "^5.102.3",
    "axios": "^1.7.9",
    "expo": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "^57.0.16",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.2",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-secure-store": "^57.0.2",
    "expo-sharing": "^57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "^57.0.18",
    "expo-video": "^57.0.3",
    "expo-web-browser": "~57.0.2",
    "hono": "~4.13.4",
    "i18next": "^26.4.0",
    "nativewind": "^4.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.2",
    "react-native-airplay-btn": "^1.1.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-image-colors": "2.6.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-screens": "~4.27.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.11.4",
    "semver": "^7.8.5",
    "tailwindcss": "3.4.19",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.14",
    "detox": "^20.31.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@sentry/react-native",
        "@shopify/flash-list",
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
