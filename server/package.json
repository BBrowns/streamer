{
  "name": "@streamer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node26 --sourcemap --outfile=dist/index.js --packages=external --alias:@streamer/shared=../packages/shared/src/index.ts",
    "start": "node dist/index.js",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "pretest:integration": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/hono-api-reference": "^0.11.16",
    "@sentry/node": "^10.71.0",
    "@streamer/shared": "*",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "cockatiel": "^4.0.0",
    "express-rate-limit": "^8.2.1",
    "hono": "~4.13.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/config": "^7.8.0",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
