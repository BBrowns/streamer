+  val seekableTimeRanges: List<Map<String, Double>>
+    get() {
+      val timeline = player.currentTimeline
+      if (timeline.isEmpty) return emptyList()
+      val window = Timeline.Window()
+      timeline.getWindow(player.currentMediaItemIndex, window)
+      if (!window.isSeekable || window.durationMs == C.TIME_UNSET || window.durationMs <= 0) {
+        return emptyList()
+      }
+      return listOf(mapOf("start" to 0.0, "end" to window.durationMs / 1000.0))
+    }
+
+  /**
+   * Media3 exposes one contiguous buffered position for the active playback
+   * position. Anchor it at currentPosition so a distant seek never paints all
+   * earlier timeline positions as buffered.
+   */
+  val bufferedRanges: List<Map<String, Double>>
+    get() {
+      if (player.currentMediaItem == null || player.playbackState == STATE_BUFFERING) {
+        return emptyList()
+      }
+      val start = player.currentPosition / 1000.0
+      val end = player.bufferedPosition / 1000.0
+      if (!start.isFinite() || !end.isFinite() || end <= start) return emptyList()
+      return listOf(mapOf("start" to start, "end" to end))
     }
 
